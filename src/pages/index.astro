<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Spacey Focus — A focused Pomodoro timer."
    />
    <meta name="theme-color" content="#100f0d" />
    <link rel="icon" href="/fav2.ico" />
    <title>Spacey Focus — Pomodoro Timer</title>

    <!-- is:global because some elements (history items, YouTube player frame)
         are created from JS and would not receive Astro's scoping attribute -->
    <style is:global>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
        color: #f5f3ef;
        background: #100f0d;
      }

      .timer-app {
        width: min(100% - 32px, 448px);
        margin: 70px auto;
        text-align: center;
      }

      /* Main timer card: no background, only gradient left and right edges */
      .timer {
        position: relative;
        padding: 30px 28px 32px;
      }

      .timer::before,
      .timer::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 3px;
        pointer-events: none;
      }

      /* Left edge: transparent at the top, bright white at the bottom */
      .timer::before {
        left: 0;
        background: linear-gradient(to bottom, transparent, #ffffff);
      }

      /* Right edge: bright white at the top, transparent at the bottom */
      .timer::after {
        right: 0;
        background: linear-gradient(to bottom, #ffffff, transparent);
      }

      .timer-icon {
        color: #ffffff;
        filter: grayscale(1) brightness(0) invert(1);
        font-size: 25px;
        height: 28px;
        margin-bottom: 13px;
      }

      #background-layer,
      #background-next {
        position: fixed;
        inset: 0;
        z-index: -1;
        background-position: center center;
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        transition: opacity 8s ease-in-out;
      }

      /* The first background lives here (not on body), so the crossfade
         never reveals a duplicate of it underneath. */
      #background-layer {
  opacity: 1;
}

      #background-next {
        opacity: 0;
      }

      .display {
        color: #f5f3ef;
        font-size: clamp(65px, 15vw, 84px);
        line-height: 1.15;
        font-weight: 400;
        letter-spacing: 1px;
        font-variant-numeric: tabular-nums;
      }

      #phase {
        margin: 12px 0 22px;
        color: #fff;
        font-size: 11px;
        letter-spacing: 2px;
      }

      /* Focus and break duration settings */
      .duration-settings {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 16px;
        font-size: 20px;
      }

      .duration-settings input {
        width: 75px;
        padding: 8px;
        font-size: 20px;
        border-radius: 0;
        border-left: none;
        border-right: none;
        position: relative;
        border-top: 1px solid transparent;
        border-bottom: 1px solid transparent;
        background:
          linear-gradient(to right, transparent, currentColor) top,
          linear-gradient(to right, transparent, currentColor) bottom;
        background-size: 100% 1px;
        background-repeat: no-repeat;
      }

      .setting {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      label {
        color: #fff;
        font-size: 13px;
      }

      /* General input styling */
      input {
        color-scheme: dark;
        width: 65px;
        padding: 6px 8px;
        text-align: center;
        border: 1px solid rgba(210, 205, 195, 0.4);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.06);
        color: #f5f3ef;
        font: inherit;
        font-size: 13px;
        outline: none;
      }

      input:focus {
        border-color: #9baac0;
      }

      /* Normal status messages stay hidden (design choice);
         validation errors are shown. */
      #status {
        display: none;
        color: #9baac0;
        min-height: 17px;
        margin: 17px 0 0;
        font-size: 12px;
      }

      #status.error {
        display: block;
        color: #ff9b9b;
      }

      /* Timer controls */
      .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
      }

      /* General button styling */
      button {
        padding: 13px 29px;
        border: 1px solid rgba(210, 205, 195, 0.4);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.045);
        color: #f5f3ef92;
        cursor: pointer;
        font-size: 18px;
        transition: background 0.2s, border-color 0.2s;
      }

      button:hover {
        background: rgba(169, 174, 184, 0.23);
        border-color: rgba(99, 99, 94, 0.3);
      }

      #start {
        min-width: 100px;
      }

      /* Statistics */
      .statistics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 32px;
      }

      .stat-card {
        padding: 17px 10px 15px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(20, 25, 35, 0.12);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }

      .history-card {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
      }

      .history-toggle {
        width: 100%;
        min-height: 54px;
        padding: 12px 18px;
        border: none;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: #f5f3ef;
        font-size: 22px;
        font-weight: 500;
      }

      .history-toggle:hover:not(:disabled) {
        background: transparent;
        border-color: transparent;
      }

      .stat-number {
        color: #f5f3ef;
        margin: 0;
        font-size: 31px;
        line-height: 1.2;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .stat-label {
        margin: 3px 0 0;
        color: #9baac0;
        font-size: 12px;
      }

      /* History panel */
      .history-panel {
        position: fixed;
        top: 35px;
        left: clamp(32px, calc((100vw - 1100px) / 2), 150px);
        z-index: 10;
        width: min(300px, calc(100vw - 64px));
        max-height: calc(100vh - 80px);
        overflow-y: auto;
        padding: 20px 22px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        text-align: left;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      }

      /* On narrow screens the panel flows below the stats instead of
         covering the timer. */
      @media (max-width: 899px) {
        .history-panel {
          position: static;
          width: 100%;
          max-height: none;
          margin-top: 12px;
        }
      }

      .history-panel h2 {
        margin: 0;
        color: #efebe7;
        font-size: 17px;
        font-weight: 500;
      }

      .history-total {
        margin: 8px 0 14px;
        color: #9baac0;
        font-size: 12px;
      }

      .history-list {
        display: grid;
        gap: 9px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .history-item span:last-child,
      .history-empty {
        color: #9baac0;
      }

      .history-empty {
        font-size: 13px;
      }

      /* Music */
      .music-section {
        margin-top: 30px;
      }

      .music-toggle {
        padding: 9px 18px;
        color: #ffffff;
        font-size: 13px;
      }

      .music-toggle span {
        margin-right: 5px;
        font-size: 16px;
      }

      /* Music glass panel */
      .music-panel {
        color: #f5f3ef;
        margin-top: 17px;
        padding: 22px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 18px;
        text-align: left;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        background: rgba(20, 25, 35, 0);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
      }

      .music-panel h2 {
        color: #f5f3ef;
        margin: 0;
        font-size: 17px;
        font-weight: 500;
      }

      .music-panel > p {
        color: #9baac0;
        font-size: 12px;
        line-height: 1.5;
      }

      .music-input-row {
        display: flex;
        gap: 8px;
        margin-top: 14px;
      }

      .music-input-row input {
        width: 100%;
        min-width: 0;
        border-radius: 8px;
        text-align: left;
        padding: 10px;
      }

      .music-input-row button {
        padding: 9px 16px;
        border-radius: 8px;
      }

      #music-status {
        min-height: 16px;
      }

      #music-player-container {
        margin-top: 15px;
      }

      .music-note {
        margin-bottom: 0;
      }

      /* YouTube player */
      .youtube-player-frame {
        position: relative;
        width: 250px;
        height: 250px;
        max-width: 100%;
        margin: 12px auto 0;
        overflow: hidden;
        border-radius: 10px;
        background: #000;
      }

      .youtube-player-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Desktop music positioning */
      @media (min-width: 900px) {
        .music-section {
          position: fixed;
          top: 35px;
          right: clamp(32px, calc((100vw - 1100px) / 2), 150px);
          margin-top: 0;
          z-index: 10;
        }

        .music-panel {
          width: 300px;
          margin-left: auto;
        }
      }

      /* Hide elements controlled by JavaScript */
      [hidden] {
        display: none !important;
      }

      /* Mobile adjustments */
      @media (max-width: 430px) {
        .timer-app {
          margin: 35px auto;
        }

    /* Hide the "Today" card; History spans the full width */
      .statistics {
      grid-template-columns: 1fr;
      }

      .statistics .stat-card:not(.history-card) {
        display: none;
        }

      /* History button: no borders, blurred backdrop that fades out softly at the edges */
      .statistics .history-card {
        min-height: 72px;
        border: 0;
        box-shadow: none;
        background: rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        -webkit-mask-image: radial-gradient(ellipse closest-side, #000 55%, transparent 100%);
        mask-image: radial-gradient(ellipse closest-side, #000 55%, transparent 100%);
      }

        .timer {
          padding: 25px 16px;
        }

        .duration-settings {
          gap: 12px;
        }

        .setting {
          gap: 6px;
        }

        .controls {
          gap: 7px;
        }

        button {
          padding: 11px 20px;
        }
      }
            /* Account links */
      .account {
        position: fixed;
        bottom: 14px;
        right: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 13px;
      }

      .account a,
      .account span {
        color: #f5f3ef;
        opacity: 0.75;
        text-decoration: none;
      }

      .account a:hover {
        opacity: 1;
      }

      .account button {
        padding: 6px 14px;
        font-size: 13px;
        border-radius: 16px;
      }

      /* Signature */
      .signature {
        position: fixed;
        bottom: 10px;
        left: 20px;
        width: 45px;
        height: auto;
        opacity: 1;
        z-index: 10;
        pointer-events: none;
      }
      /* Add / remove sessions in the History panel */
      /* Remove: just an X at the right end of each session */
.history-remove {
  padding: 0 2px;
  border: 0;
  border-radius: 0;
  background: none;
  color: #ebedf1;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  transition: color 0.2s ease;
}

.history-remove:hover {
  background: none;
  border-color: transparent;
  color: #a1bfd2;
}

.history-remove.confirm {
  color: #ff9b9b;
  font-size: 12px;
}

/* Keeps the X on the same line, at the right edge */
.history-item {
  flex-wrap: nowrap;
}

  

      .history-feedback {
        min-height: 16px;
        margin: 12px 0 0;
        font-size: 12px;
        color: #9baac0;
      }

      .history-feedback.error {
        color: #ff9b9b;
      }

      .history-add-toggle {
        margin-top: 8px;
        padding: 7px 14px;
        border-radius: 16px;
        font-size: 13px;
        color: #f5f3ef;
      }

      .add-session-form {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 8px 10px;
        align-items: center;
        margin-top: 12px;
      }

      .add-session-form label {
        font-size: 12px;
        color: #9baac0;
      }

      .add-session-form input {
        width: 100%;
        padding: 6px 10px;
        border-radius: 10px;
        font-size: 14px;
        text-align: left;
      }

      .add-session-actions {
        grid-column: 1 / -1;
        display: flex;
        gap: 8px;
      }

      .add-session-actions button {
        flex: 1;
        padding: 8px;
        border-radius: 14px;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        /* 16px stops iPhones from zooming in on the fields */
        .add-session-form input {
          font-size: 16px;
        }
      }
      /* "Today : 2 sessions" in the top-left corner */
.today-card {
  position: fixed;
  top: 35px;
  left: clamp(32px, calc((100vw - 1100px) / 2), 150px);
  z-index: 10;
  padding: 0;
  border: 0;
  background: none;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.today-line {
  display: flex;
  align-items: baseline;
  gap: 7px;
  margin: 0;
  font-size: 16px;
  color: #f5f3ef;
}

.today-label {
  color: #fafafa;
}

.today-colon {
  color: #fbfcff;
}

.today-number {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* Only the History button is left in the stats row */
.statistics {
  grid-template-columns: minmax(0, 220px);
  justify-content: center;
}

/* Open the History panel below the Today text instead of on top of it */
.history-panel {
  top: 80px;
  max-height: calc(100vh - 120px);
}
/* ---------- History button and panel ---------- */

/* The panel fades and slides open instead of popping in */
.history-panel {
  opacity: 0;
  transform: translateY(-6px);
  clip-path: inset(0 0 100% 0);
  transition: opacity 0.3s ease, transform 0.35s ease, clip-path 0.35s ease;
}

.history-panel.open {
  opacity: 1;
  transform: none;
  clip-path: inset(-30px);
}

/* The animated outline only exists on desktop */
.history-outline {
  display: none;
}

@keyframes history-gaps {
  from {
    stroke-dashoffset: 0;
  }
  to {
    stroke-dashoffset: -99;
  }
}

@media (min-width: 900px) {
  .statistics .history-card {
    position: fixed;
    top: 70px;
    left: clamp(32px, calc((100vw - 1100px) / 2), 150px);
    z-index: 10;
    display: block;
    width: 200px;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .statistics .history-toggle {
    position: relative;
    width: 200px;
    height: 44px;
    min-height: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.22em;
  }

  .statistics .history-toggle:focus-visible {
    outline: 1px solid #ffffff;
    outline-offset: 4px;
  }

  /* text-indent balances the extra space letter-spacing adds after the last letter */
  .history-label {
    position: relative;
    display: block;
    text-indent: 0.22em;
  }

  .history-outline {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.55));
    transition: filter 0.3s ease;
  }

  .history-outline rect {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.5;
    /* 3 repeats of (31 dash + 2 gap) = 99, so 3 gaps and a seamless loop */
    stroke-dasharray: 31 2;
    animation: history-gaps 9s linear infinite;
    transition: stroke 0.3s ease;
  }

  .history-toggle:hover .history-outline {
    filter: drop-shadow(0 0 7px rgba(254, 253, 255, 0.11));
  }

  .history-toggle:hover .history-outline rect {
    stroke: #e4e4e4;
  }

  /* The panel opens directly below the button */
  .history-panel {
    top: 126px;
    max-height: calc(100vh - 150px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .history-panel {
    transition: none;
  }

  .history-outline rect {
    animation: none;
  }
}
/* ---------- Time picker and "Add session" (desktop only) ---------- */
/* ---------- Start time: typed boxes on desktop, scroll wheels on touch screens ---------- */

/* The custom field replaces the plain label on every screen size */
label[for="add-time"] {
  display: none;
}

.time-picker {
  grid-column: 1 / -1;
}

.time-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  color: #f5f3ef;
}

.time-field-title {
  display: block;
  font-size: 13px;
  color: #f5f3ef;
}

.time-field-sub {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  color: #9baac0;
}

.time-boxes {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 3px;
  border: 1.5px solid transparent;
  border-radius: 9px;
  transition: border-color 0.2s ease;
}

.time-picker .time-box {
  width: 38px;
  min-width: 0;
  padding: 5px 0;
  border: 0;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.1);
  color: #f5f3ef;
  font-size: 15px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  caret-color: #ffffff;
  outline: none;
}

.time-colon {
  color: #9baac0;
}

/* Blue outline around the boxes while typing, or while the wheels are open */
.time-boxes:focus-within,
.time-picker.open .time-boxes {
  border-color: #5b7fe0;
}

/* Scroll wheels exist on touch screens only */
.time-wheel {
  display: none;
}

@media (max-width: 899px) {
  .time-field {
    cursor: pointer;
  }

  .time-picker .time-box {
    font-size: 16px;
    cursor: pointer;
  }

  .time-wheel {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 22px;
    height: 140px;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transition:
      max-height 0.3s ease,
      margin-top 0.3s ease,
      opacity 0.25s ease,
      visibility 0s linear 0.3s;
  }

  .time-picker.open .time-wheel {
    max-height: 140px;
    margin-top: 10px;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .wheel-col {
    width: 56px;
    height: 140px;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    outline: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 32%, #000 68%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 32%, #000 68%, transparent 100%);
  }

  .wheel-col::-webkit-scrollbar {
    display: none;
  }

  /* Empty space above and below, so the first and last values can reach the middle */
  .wheel-col::before,
  .wheel-col::after {
    content: "";
    display: block;
    height: 56px;
  }

  .wheel-item {
    height: 28px;
    line-height: 28px;
    color: #9baac0;
    font-size: 15px;
    text-align: center;
    font-variant-numeric: tabular-nums;
    scroll-snap-align: center;
    cursor: pointer;
  }

  .wheel-item.selected {
    color: #ffffff;
    font-weight: 600;
  }

  /* Blue band around the selected time, with the colon in the middle */
  .wheel-band {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 50%;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateY(-50%);
    border: 1.5px solid #5b7fe0;
    border-radius: 9px;
    background: rgba(91, 127, 224, 0.1);
    color: #c3ccd9;
    font-size: 15px;
    pointer-events: none;
  }
}

@media (min-width: 900px) {
  /* "Add session": one thick white line underneath, nothing else */
  .history-add-toggle {
    padding: 6px 2px 7px;
    border: 0;
    border-bottom: 3px solid #ffffff;
    border-radius: 0;
    background: transparent;
    color: #ffffff;
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .history-add-toggle:hover {
    background: transparent;
    border-bottom-color: #ffffff;
  }

  .history-add-toggle:focus-visible {
    outline: 1px solid #ffffff;
    outline-offset: 4px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .time-wheel,
  .time-boxes {
    transition: none;
  }
}

/* ---------- Glass buttons: Start / Skip, Pause, Reset ---------- */
@property --glow-a {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 50%;
}

@property --glow-b {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 50%;
}

/* The glow splits, travels to the left and right edges, then returns to the middle */
@keyframes glow-split {
  0% {
    transform: scale(1);
    opacity: 0.85;
  }
  40% {
    transform: scale(1.25, 1.5);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 0.85;
  }
}

.controls button {
  position: relative;
  isolation: isolate;
  border: 0;
  border-radius: 16px;
  background: none;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  color: #ffffff;
  transition: transform 0.15s ease;
}


.controls button::before {
  transition: width 0.25s ease;
}

.controls button:hover:not(:disabled)::before {
  width: 44px;
}

/* The white glow rising from the bottom edge */
.controls button::after {
  content: "";
  position: absolute;
  left: -8px;
  right: -8px;
  bottom: -16px;
  height: 32px;
  z-index: -1;
  background:
    radial-gradient(ellipse 45% 50% at var(--glow-a) 50%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0) 75%),
    radial-gradient(ellipse 45% 50% at var(--glow-b) 50%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.18) 45%, rgba(255, 255, 255, 0) 75%);
  filter: blur(6px);
  opacity: 0.85;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.controls button:hover {
  background: none;
  border: 0;
}

.controls button:hover:not(:disabled)::after {
  opacity: 1;
}

.controls button:active:not(:disabled) {
  transform: scale(0.985);
}

.controls button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.controls button.glow-go::after {
  animation: glow-split 0.9s ease-in-out;
}

@media (prefers-reduced-motion: reduce) {
  .controls button.glow-go::after {
    animation: none;
  }
}

