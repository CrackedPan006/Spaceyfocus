  const desktop = desktopQuery.matches;

  timeBoxH.readOnly = !desktop;
  timeBoxM.readOnly = !desktop;

  if (desktop) setTimePickerOpen(false);
}

desktopQuery.addEventListener("change", applyPickerMode);
applyPickerMode();

