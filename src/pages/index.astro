<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Spacey Focus — A focused Pomodoro timer."
    />
    <meta name="theme-color" content="#100f0d" />
    <link rel="icon" href="/fav2.ico" />
    <title>Spacey Focus — Pomodoro Timer</title>

    <!-- is:global because some elements (history items, YouTube player frame)
         are created from JS and would not receive Astro's scoping attribute -->
    <style is:global>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
        color: #f5f3ef;
        background: #100f0d;
      }

      .timer-app {
        width: min(100% - 32px, 448px);
        margin: 70px auto;
        text-align: center;
      }

      /* Main timer card: no background, only gradient left and right edges */
      .timer {
        position: relative;
        padding: 30px 28px 32px;
      }

      .timer::before,
      .timer::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        width: 3px;
        pointer-events: none;
      }

      /* Left edge: transparent at the top, bright white at the bottom */
      .timer::before {
        left: 0;
        background: linear-gradient(to bottom, transparent, #ffffff);
      }

      /* Right edge: bright white at the top, transparent at the bottom */
      .timer::after {
        right: 0;
        background: linear-gradient(to bottom, #ffffff, transparent);
      }

      .timer-icon {
        color: #ffffff;
        filter: grayscale(1) brightness(0) invert(1);
        font-size: 25px;
        height: 28px;
        margin-bottom: 13px;
      }

      #background-layer,
      #background-next {
        position: fixed;
        inset: 0;
        z-index: -1;
        background-position: center center;
        background-size: cover;
        background-repeat: no-repeat;
        background-attachment: fixed;
        transition: opacity 8s ease-in-out;
      }

      /* The first background lives here (not on body), so the crossfade
         never reveals a duplicate of it underneath. */
      #background-layer {
        opacity: 1;
        background-image:
          linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)),
          url("/backgrounds/background1.jpg");
      }

      #background-next {
        opacity: 0;
      }

      .display {
        color: #f5f3ef;
        font-size: clamp(65px, 15vw, 84px);
        line-height: 1.15;
        font-weight: 400;
        letter-spacing: 1px;
        font-variant-numeric: tabular-nums;
      }

      #phase {
        margin: 12px 0 22px;
        color: #fff;
        font-size: 11px;
        letter-spacing: 2px;
      }

      /* Focus and break duration settings */
      .duration-settings {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 16px;
        font-size: 20px;
      }

      .duration-settings input {
        width: 75px;
        padding: 8px;
        font-size: 20px;
        border-radius: 0;
        border-left: none;
        border-right: none;
        position: relative;
        border-top: 1px solid transparent;
        border-bottom: 1px solid transparent;
        background:
          linear-gradient(to right, transparent, currentColor) top,
          linear-gradient(to right, transparent, currentColor) bottom;
        background-size: 100% 1px;
        background-repeat: no-repeat;
      }

      .setting {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      label {
        color: #fff;
        font-size: 13px;
      }

      /* General input styling */
      input {
        color-scheme: dark;
        width: 65px;
        padding: 6px 8px;
        text-align: center;
        border: 1px solid rgba(210, 205, 195, 0.4);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.06);
        color: #f5f3ef;
        font: inherit;
        font-size: 13px;
        outline: none;
      }

      input:focus {
        border-color: #9baac0;
      }

      /* Normal status messages stay hidden (design choice);
         validation errors are shown. */
      #status {
        display: none;
        color: #9baac0;
        min-height: 17px;
        margin: 17px 0 0;
        font-size: 12px;
      }

      #status.error {
        display: block;
        color: #ff9b9b;
      }

      /* Timer controls */
      .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 20px;
      }

      /* General button styling */
      button {
        padding: 13px 29px;
        border: 1px solid rgba(210, 205, 195, 0.4);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.045);
        color: #f5f3ef92;
        cursor: pointer;
        font-size: 18px;
        transition: background 0.2s, border-color 0.2s;
      }

      button:hover {
        background: rgba(169, 174, 184, 0.23);
        border-color: rgba(99, 99, 94, 0.3);
      }

      #start {
        min-width: 100px;
      }

      /* Statistics */
      .statistics {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 32px;
      }

      .stat-card {
        padding: 17px 10px 15px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(20, 25, 35, 0.12);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }

      .history-card {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
      }

      .history-toggle {
        width: 100%;
        min-height: 54px;
        padding: 12px 18px;
        border: none;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: #f5f3ef;
        font-size: 22px;
        font-weight: 500;
      }

      .history-toggle:hover:not(:disabled) {
        background: transparent;
        border-color: transparent;
      }

      .stat-number {
        color: #f5f3ef;
        margin: 0;
        font-size: 31px;
        line-height: 1.2;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .stat-label {
        margin: 3px 0 0;
        color: #9baac0;
        font-size: 12px;
      }

      /* History panel */
      .history-panel {
        position: fixed;
        top: 35px;
        left: clamp(32px, calc((100vw - 1100px) / 2), 150px);
        z-index: 10;
        width: min(300px, calc(100vw - 64px));
        max-height: calc(100vh - 80px);
        overflow-y: auto;
        padding: 20px 22px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        text-align: left;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
      }

      /* On narrow screens the panel flows below the stats instead of
         covering the timer. */
      @media (max-width: 899px) {
        .history-panel {
          position: static;
          width: 100%;
          max-height: none;
          margin-top: 12px;
        }
      }

      .history-panel h2 {
        margin: 0;
        color: #efebe7;
        font-size: 17px;
        font-weight: 500;
      }

      .history-total {
        margin: 8px 0 14px;
        color: #9baac0;
        font-size: 12px;
      }

      .history-list {
        display: grid;
        gap: 9px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .history-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .history-item span:last-child,
      .history-empty {
        color: #9baac0;
      }

      .history-empty {
        font-size: 13px;
      }

      /* Music */
      .music-section {
        margin-top: 30px;
      }

      .music-toggle {
        padding: 9px 18px;
        color: #ffffff;
        font-size: 13px;
      }

      .music-toggle span {
        margin-right: 5px;
        font-size: 16px;
      }

      /* Music glass panel */
      .music-panel {
        color: #f5f3ef;
        margin-top: 17px;
        padding: 22px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 18px;
        text-align: left;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        background: rgba(20, 25, 35, 0);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
      }

      .music-panel h2 {
        color: #f5f3ef;
        margin: 0;
        font-size: 17px;
        font-weight: 500;
      }

      .music-panel > p {
        color: #9baac0;
        font-size: 12px;
        line-height: 1.5;
      }

      .music-input-row {
        display: flex;
        gap: 8px;
        margin-top: 14px;
      }

      .music-input-row input {
        width: 100%;
        min-width: 0;
        border-radius: 8px;
        text-align: left;
        padding: 10px;
      }

      .music-input-row button {
        padding: 9px 16px;
        border-radius: 8px;
      }

      #music-status {
        min-height: 16px;
      }

      #music-player-container {
        margin-top: 15px;
      }

      .music-note {
        margin-bottom: 0;
      }

      /* YouTube player */
      .youtube-player-frame {
        position: relative;
        width: 250px;
        height: 250px;
        max-width: 100%;
        margin: 12px auto 0;
        overflow: hidden;
        border-radius: 10px;
        background: #000;
      }

      .youtube-player-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }

      /* Desktop music positioning */
      @media (min-width: 900px) {
        .music-section {
          position: fixed;
          top: 35px;
          right: clamp(32px, calc((100vw - 1100px) / 2), 150px);
          margin-top: 0;
          z-index: 10;
        }

        .music-panel {
          width: 300px;
          margin-left: auto;
        }
      }

      /* Hide elements controlled by JavaScript */
      [hidden] {
        display: none !important;
      }

      /* Mobile adjustments */
      @media (max-width: 430px) {
        .timer-app {
          margin: 35px auto;
        }

    /* Hide the "Today" card; History spans the full width */
      .statistics {
      grid-template-columns: 1fr;
      }

      .statistics .stat-card:not(.history-card) {
        display: none;
        }

      /* History button: no borders, blurred backdrop that fades out softly at the edges */
      .statistics .history-card {
        min-height: 72px;
        border: 0;
        box-shadow: none;
        background: rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        -webkit-mask-image: radial-gradient(ellipse closest-side, #000 55%, transparent 100%);
        mask-image: radial-gradient(ellipse closest-side, #000 55%, transparent 100%);
      }

        .timer {
          padding: 25px 16px;
        }

        .duration-settings {
          gap: 12px;
        }

        .setting {
          gap: 6px;
        }

        .controls {
          gap: 7px;
        }

        button {
          padding: 11px 20px;
        }
      }
            /* Account links */
      .account {
        position: fixed;
        bottom: 14px;
        right: 20px;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 13px;
      }

      .account a,
      .account span {
        color: #f5f3ef;
        opacity: 0.75;
        text-decoration: none;
      }

      .account a:hover {
        opacity: 1;
      }

      .account button {
        padding: 6px 14px;
        font-size: 13px;
        border-radius: 16px;
      }

      /* Signature */
      .signature {
        position: fixed;
        bottom: 10px;
        left: 20px;
        width: 45px;
        height: auto;
        opacity: 1;
        z-index: 10;
        pointer-events: none;
      }
      /* ---------- Mobile ---------- */
html {
  -webkit-text-size-adjust: 100%;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}
.scroll-hint {
  display: none;
}

@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
}

@media (max-width: 600px) {
  body {
    min-height: 100vh;
    min-height: 100dvh;
  }

  /* iPhones don't support fixed backgrounds and scrolling gets jumpy */
  #background-layer,
  #background-next {
    background-attachment: scroll;
  }

  .timer-app {
  display: flex;
  flex-direction: column;
  margin: calc(20px + env(safe-area-inset-top, 0px)) auto 0;
  min-height: min(calc(100vh - 20px), 620px);
  min-height: min(calc(100dvh - 20px - env(safe-area-inset-top, 0px)), 620px);
}
.scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  margin-top: auto;
  padding: 18px 0 calc(12px + env(safe-area-inset-bottom, 0px));
  color: #f5f3ef;
  font-size: 13px;
  text-decoration: none;
  opacity: 0.75;
}

.scroll-hint-arrow {
  width: 9px;
  height: 9px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
}

  .timer {
    padding: 16px 12px 18px;
  }

  .timer-icon {
    height: 24px;
    margin-bottom: 8px;
    font-size: 22px;
  }

  .display {
    font-size: clamp(56px, 19vw, 76px);
  }

  #phase {
    margin: 8px 0 16px;
  }

  /* Focus and Break side by side instead of stacked */
  .duration-settings {
    flex-direction: row;
    gap: 22px;
  }

  .controls {
    gap: 8px;
    margin-top: 16px;
  }

  .controls button {
    flex: 1;
    min-width: 0;
    padding: 12px 6px;
    font-size: 16px;
  }

  #start {
    min-width: 0;
  }

  .statistics {
    margin-top: 16px;
    gap: 8px;
  }

  .stat-card {
    padding: 12px 8px;
  }

  .stat-number {
    font-size: 26px;
  }

  .history-toggle {
    min-height: 44px;
    padding: 8px 12px;
    font-size: 20px;
  }

  .music-section {
    margin-top: 14px;
  }

  .music-toggle {
    padding: 12px 20px;
  }

  .music-panel {
    padding: 16px;
  }

  /* 16px stops iPhones from zooming in when you tap the field */
  .music-input-row input {
    font-size: 16px;
  }

.account {
  position: static;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px 20px;
  padding: 28px 16px calc(36px + env(safe-area-inset-bottom, 0px));
  border: 0;
  background: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

  .account a,
  .account span,
  .account button {
    font-size: 14px;
  }

  .account a {
    padding: 8px 4px;
  }

  .account button {
    padding: 8px 14px;
  }

  #account-email {
    max-width: 38vw;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Signature moves to the top-left corner so it doesn't cover the bar */
  .signature {
    top: calc(10px + env(safe-area-inset-top, 0px));
    bottom: auto;
    left: 14px;
    width: 34px;
  }
}
    </style>
  </head>

  <body>
    <div id="background-layer"></div>
    <div id="background-next"></div>

    <main class="timer-app">
      <section class="timer" aria-label="Pomodoro timer">
        <div id="phase-icon" class="timer-icon" aria-hidden="true">👓</div>

        <div
          id="display"
          class="display"
          role="timer"
          aria-label="Time remaining"
          aria-live="off"
        >
          50:00
        </div>

        <p id="phase">FOCUS SESSION</p>

        <div class="duration-settings">
          <div class="setting">
            <label for="duration">Focus</label>
            <input
              id="duration"
              type="number"
              min="1"
              max="180"
              value="50"
            />
          </div>

          <div class="setting">
            <label for="break-duration">Break</label>
            <input
              id="break-duration"
              type="number"
              min="1"
              max="180"
              value="12"
            />
          </div>
        </div>

        <p id="status" role="status">Ready to focus</p>

        <div class="controls">
          <button id="start">Start</button>
          <button id="pause" disabled>Pause</button>
          <button id="reset">Reset</button>
        </div>
      </section>

      <section class="statistics" aria-label="Daily statistics">
        <div class="stat-card">
          <p id="today-count" class="stat-number">0</p>
          <p class="stat-label">Today</p>
        </div>

        <div class="stat-card history-card">
          <button
            id="history-toggle"
            class="history-toggle"
            aria-expanded="false"
            aria-controls="history-panel"
          >
            History
          </button>
        </div>
      </section>

      <section id="history-panel" class="history-panel" aria-label="Today's session history" hidden>
        <h2>Today's history</h2>
        <p id="history-total" class="history-total">0 Pomodoro sessions completed today</p>
        <ol id="history-list" class="history-list"></ol>
      </section>

      <section class="music-section">
        <button
          id="music-toggle"
          class="music-toggle"
          aria-expanded="false"
          aria-controls="music-panel"
        >
          <span aria-hidden="true">♫</span> Music
        </button>

        <div id="music-panel" class="music-panel" hidden>
          <h2>Focus soundtrack</h2>
          <p>Paste a YouTube video or playlist link.</p>

          <div class="music-input-row">
            <input
              id="music-url"
              type="url"
              placeholder="https://www.youtube.com/..."
              aria-label="YouTube video or playlist URL"
            />
            <button id="load-music">Load</button>
          </div>

          <p id="music-status" role="status">
            No music loaded.
          </p>

          <div id="music-player-container" hidden>
            <div class="youtube-player-frame">
              <div id="youtube-player"></div>
            </div>
          </div>

          <p class="music-note">
            Music plays during focus sessions and pauses during breaks.
          </p>
        </div>
      </section>
      <a class="scroll-hint" href="#account">
  <span>Calendar &amp; account</span>
  <span class="scroll-hint-arrow" aria-hidden="true"></span>
</a>
    </main>

    <img src="/signature.svg" alt="" class="signature" />
    <div class="account" id="account">
    <a href="/calendar">Calendar</a>
    <span id="account-email" hidden></span>
    <a id="login-link" href="/login">Log in</a>
    <a id="signup-link" href="/signup">Sign up</a>
    <button id="logout-button" hidden>Log out</button>
    </div>

    <script>
      import { pushSession, syncLocalHistory, fetchTodaySessions } from "../lib/sessions";;
      import { supabase } from "../lib/Supabase";
      const durationInput =
        document.querySelector<HTMLInputElement>("#duration")!;

      const breakDurationInput =
        document.querySelector<HTMLInputElement>("#break-duration")!;

      const display =
        document.querySelector<HTMLDivElement>("#display")!;

      const phaseIcon =
        document.querySelector<HTMLDivElement>("#phase-icon")!;

      const phaseDisplay =
        document.querySelector<HTMLParagraphElement>("#phase")!;

      const statusText =
        document.querySelector<HTMLParagraphElement>("#status")!;

      const todayCountDisplay =
        document.querySelector<HTMLParagraphElement>("#today-count")!;

      const historyToggle =
        document.querySelector<HTMLButtonElement>("#history-toggle")!;

      const historyPanel =
        document.querySelector<HTMLElement>("#history-panel")!;

      const historyTotal =
        document.querySelector<HTMLParagraphElement>("#history-total")!;

      const historyList =
        document.querySelector<HTMLOListElement>("#history-list")!;

      const startButton =
        document.querySelector<HTMLButtonElement>("#start")!;

      const pauseButton =
        document.querySelector<HTMLButtonElement>("#pause")!;

      const resetButton =
        document.querySelector<HTMLButtonElement>("#reset")!;

      const musicToggle =
        document.querySelector<HTMLButtonElement>("#music-toggle")!;

      const musicPanel =
        document.querySelector<HTMLDivElement>("#music-panel")!;

      const musicInput =
        document.querySelector<HTMLInputElement>("#music-url")!;

      const loadMusicButton =
        document.querySelector<HTMLButtonElement>("#load-music")!;

      const musicStatus =
        document.querySelector<HTMLParagraphElement>("#music-status")!;

      const musicPlayerContainer =
        document.querySelector<HTMLDivElement>("#music-player-container")!;

      // Loose typing for the YouTube IFrame API globals
      const w = window as any;

      // Notification sounds
      const focusCompleteSound = new Audio("/sounds/END.mp3");
      const breakCompleteSound = new Audio("/sounds/START.mp3");

      focusCompleteSound.preload = "auto";
      breakCompleteSound.preload = "auto";

      // ---------------------------------------------------------------
      // Status + button helpers
      // ---------------------------------------------------------------

      // Normal messages stay hidden by CSS; errors get the .error class and are shown.
      function setStatus(message: string, isError = false): void {
        statusText.textContent = message;
        statusText.classList.toggle("error", isError);
      }

      type ButtonMode = "idle" | "running" | "paused";

      function setButtons(mode: ButtonMode): void {
        startButton.disabled = false;
        startButton.textContent = mode === "idle" ? "Start" : "Skip";

        pauseButton.disabled = mode === "idle";
        pauseButton.textContent = mode === "paused" ? "Resume" : "Pause";
      }

      // ---------------------------------------------------------------
      // Timer state
      // ---------------------------------------------------------------

      let phase: "focus" | "break" = "focus";
      let remainingMs = getDuration(durationInput);
      let deadline: number | null = null;
      let interval: ReturnType<typeof setInterval> | null = null;
      let isPaused = false;

      // The music panel closes itself 5 minutes into a focus session (music keeps playing)
      const MUSIC_PANEL_AUTO_CLOSE_MS = 5 * 60 * 1000;
      let focusSessionTotalMs = 0;
      let musicPanelAutoClosed = false;

      // The ticker runs in a Web Worker so it is not throttled in background tabs
      const tickerWorker: Worker | null = createTickerWorker();

      let completedSessions = loadCompletedSessions();

      // ---------------------------------------------------------------
      // Session history (single source of truth for the "Today" counter)
      // ---------------------------------------------------------------

      type SessionRecord = {
        date: string;
        completedAt: string;
        minutes: number;
      };

      let sessionHistory: SessionRecord[] = loadSessionHistory();
      let currentDayKey = getTodayKey();

      function loadSessionHistory(): SessionRecord[] {
        try {
          const saved = localStorage.getItem("spaceyfocus-session-history");
          if (!saved) return [];

          const parsed = JSON.parse(saved);
          if (!Array.isArray(parsed)) return [];

          return parsed.filter((item): item is SessionRecord =>
            item &&
            typeof item.date === "string" &&
            typeof item.completedAt === "string" &&
            Number.isFinite(item.minutes) &&
            item.minutes > 0
          );
        } catch {
          return [];
        }
      }

      function saveSessionHistory(): void {
        try {
          localStorage.setItem(
            "spaceyfocus-session-history",
            JSON.stringify(sessionHistory)
          );
        } catch {
          // The timer can still function if session history cannot be saved.
        }
      }

      // Updates both the "Today" counter and the history panel.
      // Called only when the history changes, the panel opens, or the day changes.
      function renderHistory(): void {
        const todaysSessions = sessionHistory.filter(
          (session) => session.date === getTodayKey()
        );

        todayCountDisplay.textContent = String(todaysSessions.length);

        historyTotal.textContent =
          `${todaysSessions.length} Pomodoro ${todaysSessions.length === 1 ? "session" : "sessions"} completed today`;

        historyList.replaceChildren();

        if (todaysSessions.length === 0) {
          const emptyItem = document.createElement("li");
          emptyItem.className = "history-empty";
          emptyItem.textContent = "No completed sessions yet today.";
          historyList.appendChild(emptyItem);
          return;
        }

        todaysSessions.forEach((session, index) => {
          const item = document.createElement("li");
          item.className = "history-item";

          const sessionLabel = document.createElement("span");
          sessionLabel.textContent = `Pomodoro ${index + 1}`;

          const completedTime = new Date(session.completedAt).toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit"
          });

          const sessionDetails = document.createElement("span");
          sessionDetails.textContent = ` — ${completedTime} · ${session.minutes} min`;

          item.append(sessionLabel, sessionDetails);
          historyList.appendChild(item);
        });
      }

      // Re-render the counter/history when the calendar day rolls over
      function checkDayChange(): void {
        const today = getTodayKey();

        if (today !== currentDayKey) {
          currentDayKey = today;
          renderHistory();
        }
      }

      // ---------------------------------------------------------------
      // Durations
      // ---------------------------------------------------------------

      // Get a selected duration in milliseconds
      function getDuration(input: HTMLInputElement): number {
        const minutes = Number(input.value);

        if (!Number.isInteger(minutes) || minutes < 1 || minutes > 180) {
          throw new Error("Please enter a whole number between 1 and 180.");
        }

        return minutes * 60 * 1000;
      }

      function getCurrentDuration(): number {
        return phase === "focus"
          ? getDuration(durationInput)
          : getDuration(breakDurationInput);
      }

      // Loads the current phase's duration into remainingMs.
      // On invalid input it shows the error, sets remainingMs to 0 and returns false.
      function loadPhaseDuration(): boolean {
        try {
          remainingMs = getCurrentDuration();
          return true;
        } catch (error) {
          remainingMs = 0;
          setStatus((error as Error).message, true);
          return false;
        }
      }

      // Load completed sessions from browser storage
      function loadCompletedSessions(): number {
        try {
          const saved = localStorage.getItem("spaceyfocus-sessions");
          const parsed = saved === null ? 0 : Number(saved);

          return Number.isSafeInteger(parsed) && parsed >= 0 ? parsed : 0;
        } catch {
          return 0;
        }
      }

      function saveCompletedSessions(): void {
        try {
          localStorage.setItem(
            "spaceyfocus-sessions",
            String(completedSessions)
          );
        } catch {
          // The timer can still function if storage is unavailable.
        }
      }

      // Get the current local calendar date
      function getTodayKey(date: Date = new Date()): string {
        const now = date;
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const day = String(now.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
      }

      // Format milliseconds as MM:SS
      function formatTime(milliseconds: number): string {
        const totalSeconds = Math.ceil(milliseconds / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;

        return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
      }

      // Cheap, runs every tick: only the timer display, phase label and icon
      function render(): void {
        display.textContent = formatTime(remainingMs);

        phaseDisplay.textContent =
          phase === "focus" ? "FOCUS SESSION" : "BREAK TIME";

        phaseIcon.textContent =
          phase === "focus" ? "👓" : "🌳";
      }

      // ---------------------------------------------------------------
      // Ticker
      // ---------------------------------------------------------------

      // Browsers slow down normal timers in background tabs, but timers inside a
      // Web Worker keep running on time. Falls back to setInterval if unavailable.
      function createTickerWorker(): Worker | null {
        try {
          const source = `
            let id = null;
            self.onmessage = (event) => {
              clearInterval(id);
              id = event.data === "start"
                ? setInterval(() => self.postMessage("tick"), 200)
                : null;
            };
          `;
          const url = URL.createObjectURL(new Blob([source], { type: "text/javascript" }));
          const worker = new Worker(url);
          worker.onmessage = () => updateTimer();
          return worker;
        } catch {
          return null;
        }
      }

      function startInterval(): void {
        stopInterval();

        if (tickerWorker) {
          tickerWorker.postMessage("start");
        } else {
          interval = setInterval(updateTimer, 200);
        }
      }

      function stopInterval(): void {
        tickerWorker?.postMessage("stop");

        if (interval !== null) {
          clearInterval(interval);
          interval = null;
        }
      }

      // ---------------------------------------------------------------
      // Alerts
      // ---------------------------------------------------------------

      function playNotification(sound: HTMLAudioElement): void {
        sound.currentTime = 0;
        void sound.play().catch(() => {
          // Browser audio restrictions may prevent playback.
        });
      }

      // Runs once from the Start click (a user gesture) so that sound and system
      // notifications are allowed later, even while the tab is in the background.
      let alertsPrepared = false;

      function prepareAlerts(): void {
        if (alertsPrepared) return;
        alertsPrepared = true;

        if ("Notification" in window && Notification.permission === "default") {
          void Notification.requestPermission();
        }

        // Unlock audio playback with a silent play/pause
        [focusCompleteSound, breakCompleteSound].forEach((sound) => {
          sound.muted = true;
          sound
            .play()
            .then(() => {
              sound.pause();
              sound.currentTime = 0;
            })
            .catch(() => {})
            .finally(() => {
              sound.muted = false;
            });
        });
      }

      // System notification, shown only when the user is not looking at the page
      function notifyUser(title: string, body: string): void {
        if (
          document.hasFocus() ||
          !("Notification" in window) ||
          Notification.permission !== "granted"
        ) {
          return;
        }

        try {
          const notification = new Notification(title, {
            body,
            tag: "spacey-focus",
            silent: true // the app already plays its own sound
          });

          notification.onclick = () => {
            window.focus();
            notification.close();
          };
        } catch {
          // Some browsers (e.g. Chrome on Android) only allow notifications via a service worker.
        }
      }

      // ---------------------------------------------------------------
      // YouTube music controls
      // The actual YouTube player remains visible inside the Music panel.
      // ---------------------------------------------------------------

      type MusicLink = { videoId: string | null; playlistId: string | null };

      let ytPlayer: any = null;
      let musicLink: MusicLink | null = null;
      let musicReady = false;
      let shouldPlayMusic = false;
      let apiReady = false;

      // Extracts the video and/or playlist ID. A watch?v=X&list=Y link keeps both,
      // so the video plays inside its playlist.
      function parseYouTubeLink(input: string): MusicLink | null {
        try {
          const url = new URL(input.trim());
          const host = url.hostname.replace(/^www\./, "").toLowerCase();
          const playlistId = url.searchParams.get("list");
          let videoId: string | null = null;

          if (host === "youtu.be") {
            videoId = url.pathname.split("/").filter(Boolean)[0] ?? null;
          } else if (
            host === "youtube.com" ||
            host === "m.youtube.com" ||
            host === "music.youtube.com"
          ) {
            const parts = url.pathname.split("/").filter(Boolean);

            if (parts[0] === "shorts" || parts[0] === "embed") {
              videoId = parts[1] ?? null;
            } else {
              videoId = url.searchParams.get("v");
            }
          } else {
            return null;
          }

          if (videoId === "videoseries") videoId = null;
          if (!videoId && !playlistId) return null;

          return { videoId, playlistId };
        } catch {
          return null;
        }
      }

      function createYouTubePlayer(): void {
        if (!apiReady || !musicLink) return;

        const { videoId, playlistId } = musicLink;

        // Recreate the target element after destroying a previously loaded player.
        musicPlayerContainer.innerHTML = `
          <div class="youtube-player-frame">
            <div id="youtube-player"></div>
          </div>
        `;

        ytPlayer = new w.YT.Player("youtube-player", {
          // YouTube's minimum supported embedded-player viewport is 200 × 200.
          height: "250",
          width: "250",
          ...(videoId ? { videoId } : {}),
          playerVars: {
            autoplay: 0,
            controls: 1,
            playsinline: 1,
            ...(playlistId ? { listType: "playlist", list: playlistId } : {})
          },
          events: {
            onReady: () => {
              musicReady = true;
              musicStatus.textContent = "Music loaded. Use the YouTube controls to start playback.";

              if (shouldPlayMusic && phase === "focus" && deadline !== null) {
                playMusic();
              }
            },
            onStateChange: (event: any) => {
              const playing = event.data === w.YT.PlayerState.PLAYING;
              musicStatus.textContent = playing ? "Music is playing." : "Music paused.";
            },
            onError: () => {
              musicStatus.textContent = "This video or playlist cannot be embedded. Try another YouTube link.";
            }
          }
        });
      }

      function loadYouTubeAPI(): void {
        if (w.YT && w.YT.Player) {
          apiReady = true;
          createYouTubePlayer();
          return;
        }

        w.onYouTubeIframeAPIReady = () => {
          apiReady = true;
          createYouTubePlayer();
        };

        if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
          const script = document.createElement("script");
          script.src = "https://www.youtube.com/iframe_api";
          document.head.appendChild(script);
        }
      }

      function playMusic(): void {
        shouldPlayMusic = true;
        if (musicReady && ytPlayer && phase === "focus" && deadline !== null) {
          ytPlayer.playVideo();
        }
      }

      function pauseMusic(): void {
        shouldPlayMusic = false;
        if (musicReady && ytPlayer) ytPlayer.pauseVideo();
      }

      function loadMusic(): void {
        const link = parseYouTubeLink(musicInput.value);

        if (!link) {
          musicStatus.textContent = "Please enter a valid YouTube video or playlist link.";
          return;
        }

        // Stop whatever is playing now, but remember whether the new music
        // should start by itself (only if a focus session is running).
        if (musicReady && ytPlayer) ytPlayer.pauseVideo();
        shouldPlayMusic = phase === "focus" && deadline !== null;

        musicLink = link;
        musicReady = false;
        musicPlayerContainer.hidden = false;
        musicStatus.textContent = "Loading your music...";

        if (ytPlayer && typeof ytPlayer.destroy === "function") {
          ytPlayer.destroy();
          ytPlayer = null;
        }

        loadYouTubeAPI();
      }

      function setMusicPanelOpen(open: boolean): void {
        musicPanel.hidden = !open;
        musicToggle.setAttribute("aria-expanded", String(open));
      }

      musicToggle.addEventListener("click", () => {
        setMusicPanelOpen(musicPanel.hidden);
      });

      loadMusicButton.addEventListener("click", loadMusic);

      historyToggle.addEventListener("click", () => {
        const isOpen = !historyPanel.hidden;
        historyPanel.hidden = isOpen;
        historyToggle.setAttribute("aria-expanded", String(!isOpen));
        renderHistory();
      });

      musicInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") loadMusic();
      });

      // ---------------------------------------------------------------
      // Phase transitions
      // ---------------------------------------------------------------

      // Start the break automatically after a focus session
      function completeFocusSession(completedAt: Date = new Date(), silent = false): void {
        completedSessions++;

        // Use the length the session actually ran for, not the input's current value
        // (which may be empty/invalid right now and would throw here).
        const completedMinutes = Math.max(1, Math.round(focusSessionTotalMs / 60000));

        const record = {
        date: getTodayKey(completedAt),
        completedAt: completedAt.toISOString(),
        minutes: completedMinutes
        };
        sessionHistory.push(record);
        saveSessionHistory();
        void pushSession(record);
        saveCompletedSessions();

        if (!silent) {
        playNotification(focusCompleteSound);
          notifyUser("Focus complete!", "Time for a break.");
        }

        // Music stops as soon as the focus session ends
        pauseMusic();

        stopInterval();
        deadline = null;
        isPaused = false;

        phase = "break";
        setButtons("idle");

        if (loadPhaseDuration()) {
          setStatus("Focus complete! Enjoy your break.");
        }

        render();
        renderHistory();
      }

      // Return to focus mode after the break
      function completeBreak(): void {
        stopInterval();
        deadline = null;
        isPaused = false;

        playNotification(breakCompleteSound);
        notifyUser("Break finished", "Ready to focus?");

        phase = "focus";
        setButtons("idle");

        if (loadPhaseDuration()) {
          setStatus("Break finished. Ready to focus?");
        }

        // Music stays paused until the user starts focusing again
        render();
      }

      // Recalculate using the real deadline
      function updateTimer(): void {
        if (deadline === null) return;

        checkDayChange();

        remainingMs = Math.max(0, deadline - Date.now());

        if (
          phase === "focus" &&
          !musicPanelAutoClosed &&
          focusSessionTotalMs - remainingMs >= MUSIC_PANEL_AUTO_CLOSE_MS
        ) {
          musicPanelAutoClosed = true;
          setMusicPanelOpen(false);
        }

        if (remainingMs === 0) {
          if (phase === "focus") {
            completeFocusSession();
          } else {
            completeBreak();
          }

          return;
        }

        render();
      }

      // Start the timer
      function startTimer(): void {
        if (deadline !== null) return;

        prepareAlerts();

        if (remainingMs <= 0 && !loadPhaseDuration()) return;

        focusSessionTotalMs = remainingMs;
        musicPanelAutoClosed = false;

        deadline = Date.now() + remainingMs;
        isPaused = false;

        setStatus(
          phase === "focus"
            ? "Focus session in progress"
            : "Break in progress"
        );

        setButtons("running");

        if (phase === "focus") {
          playMusic();
        } else {
          pauseMusic();
        }

        startInterval();
        updateTimer();
      }

      // Pause or resume the timer
      function togglePauseTimer(): void {
        // If running, pause it
        if (deadline !== null) {
          remainingMs = Math.max(0, deadline - Date.now());

          if (remainingMs === 0) {
            if (phase === "focus") {
              completeFocusSession();
            } else {
              completeBreak();
            }
            return;
          }

          stopInterval();
          deadline = null;
          isPaused = true;

          pauseMusic();

          setStatus(phase === "focus" ? "Focus session paused" : "Break paused");
          setButtons("paused");

          render();
          return;
        }

        // If paused, resume it
        if (isPaused) {
          deadline = Date.now() + remainingMs;
          isPaused = false;

          setStatus(
            phase === "focus"
              ? "Focus session in progress"
              : "Break in progress"
          );

          setButtons("running");

          if (phase === "focus") {
            playMusic();
          }

          startInterval();
          updateTimer();
        }
      }

      // Skip the current phase (focus → break, break → focus)
      function skipCurrentPhase(): void {
        stopInterval();
        deadline = null;
        isPaused = false;

        pauseMusic();

        phase = phase === "focus" ? "break" : "focus";
        setButtons("idle");

        if (loadPhaseDuration()) {
          setStatus(
            phase === "break"
              ? "Focus skipped. Ready for a break?"
              : "Break skipped. Ready to focus?"
          );
        }

        render();
      }

      function resetTimer(): void {
        stopInterval();
        deadline = null;
        isPaused = false;

        pauseMusic();

        // Buttons are reset first so they stay consistent even if the input is invalid
        setButtons("idle");

        if (loadPhaseDuration()) {
          setStatus(phase === "focus" ? "Ready to focus" : "Ready for a break");
        }

        render();
      }

      // Changing the focus duration resets the current focus timer
      durationInput.addEventListener("change", () => {
        if (phase === "focus") {
          resetTimer();
        }
      });

      // Changing the break duration resets the current break timer
      breakDurationInput.addEventListener("change", () => {
        if (phase === "break") {
          resetTimer();
        }
      });

      startButton.addEventListener("click", () => {
        if (deadline !== null || isPaused) {
          skipCurrentPhase();
        } else {
          startTimer();
        }
      });

      pauseButton.addEventListener("click", togglePauseTimer);
      resetButton.addEventListener("click", resetTimer);

      // Recalculate when returning to the browser tab
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) {
          updateTimer();
          checkDayChange();
        }
      });

    const TIMER_STATE_KEY = "spaceyfocus-timer-state";
    const MAX_AWAY_MS = 12 * 60 * 60 * 1000;

    function saveTimerState(): void {
      try {
        localStorage.setItem(
          TIMER_STATE_KEY,
          JSON.stringify({
            phase,
            deadline,
            remainingMs,
            isPaused,
            focusSessionTotalMs,
            savedAt: Date.now()
          })
        );
      } catch {
        // The timer still works without saving.
      }
    }

    function restoreTimerState(): void {
      let saved: any = null;

      try {
        saved = JSON.parse(localStorage.getItem(TIMER_STATE_KEY) ?? "null");
      } catch {
        return;
      }

      if (!saved || (saved.phase !== "focus" && saved.phase !== "break")) return;
      if (!Number.isFinite(saved.savedAt) || Date.now() - saved.savedAt > MAX_AWAY_MS) return;

      phase = saved.phase;
      focusSessionTotalMs = Number.isFinite(saved.focusSessionTotalMs)
        ? saved.focusSessionTotalMs
        : 0;

      if (typeof saved.deadline === "number") {
        const now = Date.now();

        if (saved.deadline > now) {
          deadline = saved.deadline;
          remainingMs = saved.deadline - now;
          isPaused = false;
          setStatus(phase === "focus" ? "Focus session in progress" : "Break in progress");
          setButtons("running");
          startInterval();
          return;
        }

        if (phase === "focus") {
          const alreadyCounted = sessionHistory.some(
            (s) => Math.abs(new Date(s.completedAt).getTime() - saved.deadline) < 60000
          );

          if (alreadyCounted) {
            phase = "break";
            setButtons("idle");
            if (loadPhaseDuration()) setStatus("Focus complete! Enjoy your break.");
          } else {
            completeFocusSession(new Date(saved.deadline), true);
          }
        } else {
          phase = "focus";
          setButtons("idle");
          if (loadPhaseDuration()) setStatus("Break finished. Ready to focus?");
        }
        return;
      }

      // The timer was paused
      if (saved.isPaused === true && Number.isFinite(saved.remainingMs) && saved.remainingMs > 0) {
        remainingMs = saved.remainingMs;
        isPaused = true;
        setStatus(phase === "focus" ? "Focus session paused" : "Break paused");
        setButtons("paused");
        return;
      }

      // The timer was idle (e.g. waiting to start the break)
      setButtons("idle");
      if (loadPhaseDuration()) {
        setStatus(phase === "focus" ? "Ready to focus" : "Ready for a break");
      }
    }

    window.addEventListener("pagehide", saveTimerState);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) saveTimerState();
    });

    restoreTimerState();

      // Initial display
      render();
      renderHistory();
      void syncLocalHistory();
      // Add today's sessions from the cloud that this browser doesn't know about yet
      async function mergeCloudHistory(): Promise<void> {
        const cloud = await fetchTodaySessions();
        if (cloud.length === 0) return;

        const known = new Set(sessionHistory.map((s) => new Date(s.completedAt).getTime()));
        let added = false;

        for (const session of cloud) {
          if (!known.has(new Date(session.completedAt).getTime())) {
            sessionHistory.push(session);
            added = true;
          }
        }

        if (!added) return;

        sessionHistory.sort(
          (a, b) => new Date(a.completedAt).getTime() - new Date(b.completedAt).getTime()
        );
        saveSessionHistory();
        renderHistory();
      }

      void mergeCloudHistory();

      // Automatic background rotation

      const backgrounds = [
        "/backgrounds/background1.jpg",
        "/backgrounds/background2.jpg",
        "/backgrounds/background3.jpg",
        "/backgrounds/background4.jpg",
        "/backgrounds/background5.jpg",
        "/backgrounds/background6.jpg",
        "/backgrounds/background7.jpg",
        "/backgrounds/background8.jpg"
      ];

      const BACKGROUND_FADE_MS = 8000;
      let currentBackground = 0;

      const backgroundLayer = document.getElementById("background-layer")!;
      const nextBackground = document.getElementById("background-next")!;

      // The new image fades in on top of the current one. Once the fade is done,
      // it is copied to the base layer and the top layer is hidden instantly, so
      // nothing underneath ever shows through.
      function changeBackground(): void {
        const nextIndex = (currentBackground + 1) % backgrounds.length;
        const preload = new Image();

        preload.onload = () => {
          currentBackground = nextIndex;

          const imageValue = `
            linear-gradient(rgba(0, 0, 0, 0.30), rgba(0, 0, 0, 0.30)),
            url("${backgrounds[nextIndex]}")
          `;

          nextBackground.style.backgroundImage = imageValue;
          nextBackground.style.opacity = "1";

          setTimeout(() => {
            backgroundLayer.style.backgroundImage = imageValue;

            nextBackground.style.transition = "none";
            nextBackground.style.opacity = "0";
            void nextBackground.offsetHeight; // flush styles before re-enabling the transition
            nextBackground.style.transition = "";
          }, BACKGROUND_FADE_MS + 100);
        };

        preload.onerror = () => {
          // Skip an image that fails to load and try the next one on the next tick
          currentBackground = nextIndex;
        };

        preload.src = backgrounds[nextIndex];
      }

      // Change background every 10 minutes
      setInterval(changeBackground, 10 * 60 * 1000);
      // Account links: show login/signup for guests, email + logout for logged-in users
      const accountEmail = document.querySelector<HTMLSpanElement>("#account-email")!;
      const loginLink = document.querySelector<HTMLAnchorElement>("#login-link")!;
      const signupLink = document.querySelector<HTMLAnchorElement>("#signup-link")!;
      const logoutButton = document.querySelector<HTMLButtonElement>("#logout-button")!;

      function startNewAuthFlow(): void {
        try {
          localStorage.removeItem("spaceyfocus-auth-background");
        } catch (error) {
          console.warn("[auth] Could not reset the selected background.", error);
        }
      }

      loginLink.addEventListener("click", startNewAuthFlow);
      signupLink.addEventListener("click", startNewAuthFlow);

      function showAccount(email: string | null): void {
        const loggedIn = email !== null;

        accountEmail.textContent = email ?? "";
        accountEmail.hidden = !loggedIn;
        logoutButton.hidden = !loggedIn;
        loginLink.hidden = loggedIn;
        signupLink.hidden = loggedIn;
      }

      void supabase.auth
        .getSession()
        .then(({ data }) => showAccount(data.session?.user.email ?? null));

      supabase.auth.onAuthStateChange((_event, session) => {
        showAccount(session?.user.email ?? null);
      });

      logoutButton.addEventListener("click", () => {
        void supabase.auth.signOut();
      });
    </script>
  </body>
</html>