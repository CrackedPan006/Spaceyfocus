const WHEEL_ITEM_H = 28;
const desktopQuery = window.matchMedia("(min-width: 900px)");

const timePicker = document.querySelector<HTMLDivElement>("#time-picker")!;
const timeField = document.querySelector<HTMLDivElement>("#time-field")!;
const timeBoxH = document.querySelector<HTMLInputElement>("#time-box-h")!;
const timeBoxM = document.querySelector<HTMLInputElement>("#time-box-m")!;
const wheelHours = document.querySelector<HTMLDivElement>("#wheel-hours")!;
const wheelMinutes = document.querySelector<HTMLDivElement>("#wheel-minutes")!;

function pad2(n: number): string {
  return String(n).padStart(2, "0");
}

// ----- Typed boxes (desktop) -----

// Both boxes are valid whole numbers in range, or null
function readBoxes(): { hours: number; minutes: number } | null {
  if (timeBoxH.value === "" || timeBoxM.value === "") return null;

  const hours = Number(timeBoxH.value);
  const minutes = Number(timeBoxM.value);

  if (!Number.isInteger(hours) || hours < 0 || hours > 23) return null;
  if (!Number.isInteger(minutes) || minutes < 0 || minutes > 59) return null;

  return { hours, minutes };
}

// Copies the boxes into the hidden time input, but only when both are valid
function commitBoxes(): void {
  const time = readBoxes();
  if (time) addTime.value = `${pad2(time.hours)}:${pad2(time.minutes)}`;
}

function showTimeInBoxes(): void {
  const [hours, minutes] = addTime.value.split(":").map(Number);
  if (!Number.isFinite(hours) || !Number.isFinite(minutes)) return;

  timeBoxH.value = pad2(hours);
  timeBoxM.value = pad2(minutes);
}

function handleBoxInput(box: HTMLInputElement, max: number, next?: HTMLInputElement): void {
  box.value = box.value.replace(/\D/g, "").slice(0, 2);

  // A first digit that can't start a valid number (e.g. 5 for hours) becomes 05
  if (box.value.length === 1 && Number(box.value) * 10 > max) {
    box.value = pad2(Number(box.value));
  }

  if (box.value.length === 2) {
    if (Number(box.value) > max) box.value = String(max);
    commitBoxes();

    if (next) {
      next.focus();
      next.select();
    }
  }
}

// When leaving a box: pad it to two digits, or put the previous value back if it's empty
function normalizeBox(box: HTMLInputElement, max: number, savedPart: 0 | 1): void {
  const digits = box.value.replace(/\D/g, "");

  if (digits === "") {
    box.value = pad2(Number(addTime.value.split(":")[savedPart]) || 0);
  } else {
    box.value = pad2(Math.min(max, Number(digits)));
  }

  commitBoxes();
}

function stepBox(box: HTMLInputElement, max: number, step: number): void {
  const current = Number(box.value) || 0;
  box.value = pad2((current + step + max + 1) % (max + 1));
  commitBoxes();
}

[
  { box: timeBoxH, max: 23, next: timeBoxM, prev: undefined, part: 0 as const },
  { box: timeBoxM, max: 59, next: undefined, prev: timeBoxH, part: 1 as const }
].forEach(({ box, max, next, prev, part }) => {
  box.addEventListener("focus", () => {
    if (desktopQuery.matches) box.select();
  });

  box.addEventListener("input", () => handleBoxInput(box, max, next));
  box.addEventListener("blur", () => normalizeBox(box, max, part));

  box.addEventListener("keydown", (event) => {
    if (!desktopQuery.matches) return;

    if (event.key === "ArrowUp" || event.key === "ArrowDown") {
      event.preventDefault();
      stepBox(box, max, event.key === "ArrowUp" ? 1 : -1);
    } else if (event.key === "Backspace" && box.value === "" && prev) {
      prev.focus();
      prev.select();
    } else if (event.key === "Enter") {
      normalizeBox(box, max, part);
    }
  });
});

// ----- Scroll wheels (touch screens) -----

function buildWheel(column: HTMLElement, count: number): void {
  for (let i = 0; i < count; i++) {
    const item = document.createElement("div");
    item.className = "wheel-item";
    item.dataset.value = String(i);
    item.setAttribute("role", "option");
    item.textContent = pad2(i);
    column.append(item);
  }
}

buildWheel(wheelHours, 24);
buildWheel(wheelMinutes, 60);

function wheelValue(column: HTMLElement, count: number): number {
  return Math.max(0, Math.min(count - 1, Math.round(column.scrollTop / WHEEL_ITEM_H)));
}

function setWheel(column: HTMLElement, value: number, smooth = false): void {
  column.scrollTo({ top: value * WHEEL_ITEM_H, behavior: smooth ? "smooth" : "auto" });
}

function markSelected(column: HTMLElement, value: number): void {
  column.querySelector(".wheel-item.selected")?.classList.remove("selected");
  column.children[value]?.classList.add("selected");
}

// Wheels -> boxes and the hidden time input
function syncFromWheels(): void {
  const hours = wheelValue(wheelHours, 24);
  const minutes = wheelValue(wheelMinutes, 60);

  timeBoxH.value = pad2(hours);
  timeBoxM.value = pad2(minutes);
  addTime.value = `${pad2(hours)}:${pad2(minutes)}`;

  markSelected(wheelHours, hours);
  markSelected(wheelMinutes, minutes);
}

// Hidden time input -> boxes and wheels
function syncPickerFromInput(): void {
  const [hours, minutes] = addTime.value.split(":").map(Number);
  if (!Number.isFinite(hours) || !Number.isFinite(minutes)) return;

  showTimeInBoxes();

  setWheel(wheelHours, hours);
  setWheel(wheelMinutes, minutes);
  markSelected(wheelHours, hours);
  markSelected(wheelMinutes, minutes);
}

function setTimePickerOpen(open: boolean): void {
  if (open && desktopQuery.matches) return; // no wheels on desktop

  timePicker.classList.toggle("open", open);
  if (open) requestAnimationFrame(syncPickerFromInput);
}

let wheelFrame = 0;

[wheelHours, wheelMinutes].forEach((column) => {
  const count = column === wheelHours ? 24 : 60;

  column.addEventListener(
    "scroll",
    () => {
      cancelAnimationFrame(wheelFrame);
      wheelFrame = requestAnimationFrame(syncFromWheels);
    },
    { passive: true }
  );

  // Tap a number to jump to it
  column.addEventListener("click", (event) => {
    const item = (event.target as HTMLElement).closest<HTMLElement>(".wheel-item");
    if (item) setWheel(column, Number(item.dataset.value), true);
  });

  // Arrow keys step one value up or down
  column.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;

    event.preventDefault();
    const step = event.key === "ArrowDown" ? 1 : -1;
    setWheel(column, Math.max(0, Math.min(count - 1, wheelValue(column, count) + step)));
  });
});

// Touch screens: tapping the time opens or closes the wheels
timeField.addEventListener("click", () => {
  if (desktopQuery.matches) return;
  setTimePickerOpen(!timePicker.classList.contains("open"));
});

timePicker.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && timePicker.classList.contains("open")) {
    event.stopPropagation();
    setTimePickerOpen(false);
  }
});

