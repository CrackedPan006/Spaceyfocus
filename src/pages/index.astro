          if (remainingMs === 0) {
            if (phase === "focus") {
              completeFocusSession();
            } else {
              completeBreak();
            }
            return;
          }

          stopInterval();
          deadline = null;
          isPaused = true;

          pauseMusic();

          setStatus(phase === "focus" ? "Focus session paused" : "Break paused");
          setButtons("paused");

          render();
          return;
        }

        // If paused, resume it
        if (isPaused) {
          deadline = Date.now() + remainingMs;
          isPaused = false;

          setStatus(
            phase === "focus"
              ? "Focus session in progress"
              : "Break in progress"
          );

          setButtons("running");

          if (phase === "focus") {
            playMusic();
          }

          startInterval();
          updateTimer();
        }
      }

      // Skip the current phase (focus → break, break → focus)
      function skipCurrentPhase(): void {
        stopInterval();
        deadline = null;
        isPaused = false;

        pauseMusic();

        phase = phase === "focus" ? "break" : "focus";
        setButtons("idle");

