
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Choose a new password | Spacey Focus</title>
  </head>

  <body>
    <main class="container">
      <h1>Choose a new password</h1>
      <p>Enter your new password below.</p>

      <form id="password-form">
        <label for="password">New password</label>
        <input
          id="password"
          type="password"
          placeholder="At least 6 characters"
          minlength="6"
          required
        />

        <label for="confirm-password">Confirm new password</label>
        <input
          id="confirm-password"
          type="password"
          placeholder="Enter your password again"
          minlength="6"
          required
        />

        <button type="submit" id="save-button">Save new password</button>
        <p id="message" role="status"></p>
      </form>

      <a href="/login">Back to login</a>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: #0b0b18;
    color: white;
    font-family: Arial, sans-serif;
  }

  .container {
    width: min(90%, 380px);
    box-sizing: border-box;
    padding: 32px;
    border: 1px solid #39394f;
    border-radius: 12px;
    background: #151525;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 24px 0;
  }

  input {
    padding: 12px;
    border: 1px solid #55556b;
    border-radius: 6px;
    background: #222238;
    color: white;
  }

  button {
    padding: 12px;
    border: 0;
    border-radius: 6px;
    background: #a78bfa;
    color: #171326;
    font-weight: bold;
    cursor: pointer;
  }

  a {
    color: #c4b5fd;
  }

  #message {
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { Supabase } from '../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('#password-form');
  const passwordInput = document.querySelector<HTMLInputElement>('#password');
  const confirmInput = document.querySelector<HTMLInputElement>('#confirm-password');
  const button = document.querySelector<HTMLButtonElement>('#save-button');
  const message = document.querySelector<HTMLParagraphElement>('#message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!passwordInput || !confirmInput || !button || !message) return;

    if (passwordInput.value !== confirmInput.value) {
      message.textContent = 'The passwords do not match.';
      return;
    }

    button.disabled = true;
    message.textContent = 'Updating your password...';

    const { error } = await supabase.auth.updateUser({
      password: passwordInput.value,
    });

    button.disabled = false;

    if (error) {
      message.textContent = error.message;
      return;
    }

    message.textContent = 'Your password has been updated successfully!';

    passwordInput.value = '';
    confirmInput.value = '';

    setTimeout(() => {
      window.location.href = '/login';
    }, 2000);
  });
</script>
