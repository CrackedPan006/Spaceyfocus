---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Forgot password | Spacey Focus">
  <h1>Forgot your password?</h1>
  <p>Enter your email address and we'll send you a password-reset link.</p>

  <form id="reset-form">
    <label for="email">Email address</label>
    <div class="auth-input-field">
      <input
        id="email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
    </div>

    <button type="submit" id="reset-button">Send reset link</button>
    <p id="message" class="auth-message" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>

  <div class="auth-links">
    <p><a href="/login">Back to login</a></p>
  </div>
</AuthLayout>

<script>
  import { supabase } from "../lib/Supabase";

  const form = document.querySelector<HTMLFormElement>("#reset-form");
  const emailInput = document.querySelector<HTMLInputElement>("#email");
  const button = document.querySelector<HTMLButtonElement>("#reset-button");
  const message = document.querySelector<HTMLParagraphElement>("#message");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!emailInput || !button || !message) return;

    button.disabled = true;
    button.textContent = "Sending link...";
    message.dataset.state = "pending";
    message.textContent = "Requesting a password-reset email...";

    const redirectUrl = new URL("/reset-password", window.location.origin);
    let backgroundIndex: string | null = null;
    try {
      backgroundIndex = localStorage.getItem("spaceyfocus-auth-background");
    } catch (error) {
      console.warn("[auth] could not read the selected background for the reset link.", error);
    }

    if (
      backgroundIndex !== null &&
      /^\d+$/.test(backgroundIndex) &&
      Number(backgroundIndex) < 8
    ) {
      redirectUrl.searchParams.set("background", backgroundIndex);
    }

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(
        emailInput.value.trim(),
        {
          redirectTo: redirectUrl.toString(),
        }
      );

      if (error) {
        message.dataset.state = "error";
        message.textContent = error.message;
        return;
      }

      message.dataset.state = "success";
      message.textContent =
        "Reset request submitted. If an account exists for this email, check your inbox and spam folder for the link.";
    } catch (error) {
      message.dataset.state = "error";
      message.textContent =
        error instanceof Error
          ? error.message
          : "Unable to request a reset email. Please check your connection and try again.";
    } finally {
      button.disabled = false;
      button.textContent = "Send reset link";
    }
  });
</script>
