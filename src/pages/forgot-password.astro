
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Reset password | Spacey Focus</title>
  </head>

  <body>
    <main class="container">
      <h1>Forgot your password?</h1>
      <p>Enter your email address and we'll send you a password-reset link.</p>

      <form id="reset-form">
        <label for="email">Email address</label>
        <input
          id="email"
          type="email"
          placeholder="you@example.com"
          required
        />

        <button type="submit" id="reset-button">Send reset link</button>
        <p id="message" role="status"></p>
      </form>

      <a href="/login">Back to login</a>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: #0b0b18;
    color: white;
    font-family: Arial, sans-serif;
  }

  .container {
    width: min(90%, 380px);
    box-sizing: border-box;
    padding: 32px;
    border: 1px solid #39394f;
    border-radius: 12px;
    background: #151525;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 24px 0;
  }

  input {
    padding: 12px;
    border: 1px solid #55556b;
    border-radius: 6px;
    background: #222238;
    color: white;
  }

  button {
    padding: 12px;
    border: 0;
    border-radius: 6px;
    background: #a78bfa;
    color: #171326;
    font-weight: bold;
    cursor: pointer;
  }

  a {
    color: #c4b5fd;
  }

  #message {
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { Supabase } from '../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('#reset-form');
  const emailInput = document.querySelector<HTMLInputElement>('#email');
  const button = document.querySelector<HTMLButtonElement>('#reset-button');
  const message = document.querySelector<HTMLParagraphElement>('#message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!emailInput || !button || !message) return;

    button.disabled = true;
    message.textContent = 'Sending reset link...';

    const { error } = await supabase.auth.resetPasswordForEmail(
      emailInput.value.trim(),
      {
        redirectTo: 'https://spaceyfocus.space/reset-password',
      }
    );

    button.disabled = false;

    if (error) {
      message.textContent = error.message;
      return;
    }

    message.textContent =
      'If an account exists for this email, a password-reset link will be sent.';
  });
</script>
